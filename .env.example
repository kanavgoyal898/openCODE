# Safe, non-secret local defaults. Copy to .env; never commit the copy.
OPENCODE_LOG_LEVEL=INFO
OPENCODE_MAX_FILE_BYTES=2000000
OPENCODE_MAX_DIRECTORY_DEPTH=32
OPENCODE_MAX_FILES=100000
OPENCODE_DATABASE_URL=postgresql+psycopg://opencode:opencode-local-only@localhost:5432/opencode
OPENCODE_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
OPENCODE_MAX_TOTAL_BYTES=250000000
OPENCODE_MAX_REQUEST_BYTES=2100000
OPENCODE_MAX_ACTIVE_SCANS=10
OPENCODE_EXPOSE_SOURCE=false
